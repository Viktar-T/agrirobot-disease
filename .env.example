# Local secrets for piece 4. Copy to .env (git-ignored) and fill in; never commit .env.

# Hugging Face token, read scope: https://huggingface.co/settings/tokens
# Needed only for the gated DINOv3 weights (facebook/dinov3-vitl16-pretrain-lvd1689m).
# Accept the DINOv3 terms on the ML role account first (W1 task "DINOv3 terms");
# research-only until H6 C5 is signed, and the weights stay on university machines.
HF_TOKEN=

# Optional: keep the Hugging Face weight cache off the system drive (the DINOv2/v3
# large checkpoints are ~1.2 GB each).
# HF_HOME=D:/code/agrirobot-disease/data/hf_cache
