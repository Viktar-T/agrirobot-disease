{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agrirobot:interface:v0:trigger_request",
  "title": "Trigger request (interface v0, STUB, DRAFT)",
  "description": "Return channel, disease system -> robot: ask for a capture at a plot, e.g. a re-take of a frame the model service abstained on. Stub (H8 section 4 piece 1): only the envelope is specified; the payload is agreed with the robotics side later, so extra fields are allowed.",
  "type": "object",
  "required": ["contract_version", "request_id", "timestamp_utc", "site_id", "plot_id", "reason"],
  "additionalProperties": true,
  "properties": {
    "contract_version": {
      "description": "Contract version this record follows.",
      "const": "v0"
    },
    "request_id": {
      "description": "Unique id of this request (UUID).",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "timestamp_utc": {
      "description": "Time the request was issued. RFC 3339 in UTC with 'Z'.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "site_id": {
      "description": "Target site.",
      "$ref": "#/$defs/id"
    },
    "plot_id": {
      "description": "Target plot.",
      "$ref": "#/$defs/id"
    },
    "reason": {
      "description": "Why the capture is requested; free text in v0.",
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "id": {
      "description": "Identifier: same rule as in observation_frame.schema.json.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    }
  },
  "examples": [
    {
      "contract_version": "v0",
      "request_id": "0b6f3c1e-5d7a-4c2e-9f51-8a3d2b7e4c10",
      "timestamp_utc": "2026-11-24T10:02:11Z",
      "site_id": "MAK-Luwero",
      "plot_id": "P07",
      "reason": "abstain: far_from_training"
    }
  ]
}
