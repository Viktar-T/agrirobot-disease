# --- Data and large artefacts: never in git ---
# Local data root: everything under data/ except its README and the DVC pointer files
# (data/manifests.dvc, data/cache.dvc: store/README.md, "Hand-over from piece 4").
# `?*`, not `*`: DVC's git layer reads `/data/*` as ignoring data/ itself, and then never
# finds the pointer files; for git the two patterns are the same.
/data/?*
!/data/README.md
!/data/*.dvc
# ROS 2 bags
*.mcap
*.db3
# Model weights
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
# MLflow local stores
mlruns/
mlartifacts/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- ROS 2 colcon outputs ---
/build/
/install/
/log/

# --- Local secrets (e.g. Hugging Face token for the gated DINOv3 weights, database passwords) ---
.env
